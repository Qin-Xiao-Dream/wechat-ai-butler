+
+/** 连接器配置。 */
+export interface WeixinConnectorOptions extends IlinkClientOptions {
+  /** SQLite 状态库路径；默认落在状态文件同目录。 */
+  readonly state_db?: string
+  /** preset id。 */
+  readonly agent_preset?: string
