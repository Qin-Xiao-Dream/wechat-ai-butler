+        ?? process.env.DSH_GRAPH_DIR
+        ?? join(process.env.DSH_HOME ?? join(process.env.USERPROFILE ?? '.', '.dsh'), 'graph'),
+    })
+    // 启动即把中心建好（幂等）：欣爱为绝对中心，另有主人节点与两人互相的称呼。
+    // 不等到第一次空闲更新——否则刚启动时查询工具会告"图谱里还没有任何人物"。
+    try {
+      this.graph.ensure_center()
