+  /** 是否检查 OpenClaw 隔离；默认 true。 */
+  readonly enforce_openclaw_isolation?: boolean
+  /** 旧版路由状态文件路径（仅用于一次性迁移；迁移后只读保留）。 */
+  readonly state_file?: string
+  /** `/codex` 远程任务的工作目录；默认 SynLove。 */
+  readonly codex_workspace?: string
+  /** 长期记忆（时间线）根目录；默认 ~/.dsh/timeline。 */
+  readonly timeline_dir?: string
+  /** 知识图谱（社交网络）根目录；默认 ~/.dsh/graph。 */
+  readonly graph_dir?: string
+}
+
+/** 项目目录（启动器注入）；用它定位 `config/modelConfig.json` 等配置文件。 */
+const PROJECT_CONFIG_DIR = process.env.DSH_WEIXIN_WORKSPACE ?? process.cwd()
+
+/** 探测某个本地端口是否在监听（用于判断 Gemma 服务是否就绪）。 */
+function port_open(port: number): Promise<boolean> {
+  return new Promise(resolve => {
+    const socket = createConnection({ port, host: '127.0.0.1' })
+    const finish = (value: boolean): void => { socket.destroy(); resolve(value) }
+    socket.setTimeout(1_500)
+    socket.once('connect', () => finish(true))
+    socket.once('timeout', () => finish(false))
+    socket.once('error', () => finish(false))
+  })
+}
+
+/** 退避序列（毫秒）。 */
+const BACKOFF_STEPS = [1_000, 2_000, 5_000, 10_000, 20_000, 30_000]
+
+/**
+ * 思考摘要推送的最小间隔（毫秒）。
+ *
+ * 旧逻辑是"每 2 次工具调用推一次"，但很多任务只调 1 次工具（甚至 0 次），
+ * 于是用户全程看不到任何进度——明明模型一直在输出思考。
+ * 改成按时间驱动：只要距上次推送超过该间隔，就把新累积的思考摘要发一条。
+ * 可用 DSH_WEIXIN_PROGRESS_INTERVAL_MS 调整；设为 0 关闭。
+ */
+const PROGRESS_MIN_INTERVAL_MS = Number(process.env.DSH_WEIXIN_PROGRESS_INTERVAL_MS ?? '25000')
+
+/** 摘要太短就不值得单独发一条（避免刷屏）。 */
+const PROGRESS_MIN_CHARS = 12
+
+/**
+ * turn 绑定的有效期（毫秒）。
+ * 超过就认为是"重启前遗留的绑定"并强制重绑：turn 号会重复，但 context_token 可能已过期，
+ * 复用旧 token 会让回复被判 `prepare failed`。
+ */
+const BINDING_TTL_MS = Number(process.env.DSH_WEIXIN_BINDING_TTL_MS ?? String(30 * 60_000))
+
+/**
+ * agent 报错后等多久没有恢复，就把这一轮按失败收尾（毫秒）。
+ *
+ * 取 60 秒：harness 的 llm-retry 是"秒级退避重试"，重试成功的话新分片很快就会到；
+ * 60 秒还没有任何输出，基本就是额度/鉴权这类**重试也没用**的错误，早点告诉用户。
+ */
+const AGENT_ERROR_GRACE_MS = Number(process.env.DSH_WEIXIN_AGENT_ERROR_GRACE_MS ?? '60000')
+
+/**
+ * 账号指纹：给日志/租约用的**不可逆**身份标识。
+ *
+ * 以前用的是 `token.slice(0, 16)`——那是 token 的明文片段，会出现在探针日志、
+ * 租约标记文件和启动日志里，而它们都在项目目录内（会被一起拷走）。
+ * 现在改成 sha256 前 12 位：同一账号稳定可区分，但反推不出 token。
+ *
+ * @param token - 微信 bot token；缺失时返回 `'unknown'`。
+ */
+function account_fingerprint(token: string | undefined): string {
+  if (token === undefined || token === '') return 'unknown'
+  return 'acct-' + createHash('sha256').update(token).digest('hex').slice(0, 12)
+}
+
+/** 读一个 JSON 文件；读不到或坏了返回空对象（调用方都按"缺省"处理）。 */
+function read_json_file(path: string): Record<string, unknown> {
+  try {
+    return JSON.parse(readFileSync(path, 'utf8')) as Record<string, unknown>
+  } catch {
+    return {}
+  }
+}
+
+
+
+/** 微信连接器：装配 + 生命周期。 */
+export class WeixinConnector {
+  private readonly store: WeixinStateStore
+  private readonly turn_context: TurnContextStore
+  private readonly ingress: WeixinIngress
+  private readonly inbound: InboundCoordinator
+  private readonly outbound: OutboundCoordinator
+  private readonly host: HarnessSessionHost
+  private readonly lease: ConsumerLease
+  private readonly client: IlinkClient
+  /** Codex 远程桥（`/codex` 指令）。 */
+  private readonly codex_bridge: CodexBridge
+  /** Codex 任务完成监视器：任务一结束就主动推微信。 */
+  private readonly codex_watcher: CodexWatcher
+  /** opencode 远程桥（`/opencode` 指令）。 */
+  private readonly opencode_bridge: OpencodeBridge
+  /** opencode 完成监视器：只汇报外部发起的任务。 */
+  private readonly opencode_watcher: OpencodeWatcher
+  private readonly controller = new AbortController()
+  private readonly stream_disposers = new Map<string, () => void>()
+  /** 每个 Stream 的工具调用计数（用于"每 N 次工具调用推一次摘要"）。 */
+  private readonly tool_calls_seen = new Map<string, Set<string>>()
+  /**
+   * 每个 Session 当前所在的 turn。
+   * 只有 `start` 帧带 `turn`；`chunk`/`end` 帧不带，因此必须记住最近一次的 turn，
+   * 否则 turn context 会全部绑到 0（绑定/查询错位）。
+   */
+  private readonly current_turn = new Map<string, number>()
+  /**
+   * 待定的"这一轮失败了"收尾定时器（agent 报错后等宽限期，没有恢复就收尾）。
+   * 没有它的话，模型持续报错时这一轮会永远停在"处理中"。
+   */
+  private readonly turn_failure_timers = new Map<string, ReturnType<typeof setTimeout>>()
+  /** 当前在用的模型（故障转移会改它；初值来自配置）。 */
+  private current_model: ModelCandidate = { provider: '', model: '' }
+  /** 模型健康表：失活的 API 在冷却期内不再被选。 */
+  private readonly model_health = new ModelHealth()
+  /** 每个会话最近一条用户消息（换模型后要重做它）。 */
+  private readonly last_user_message = new Map<string, {
+    user_id: string, text: string, at: number, retried: boolean
+  }>()
+  /** 本轮是否报过错（用于"整轮失败却一个字都没发"时补一条说明）。 */
+  private readonly turn_error = new Map<string, string>()
+  /** 本轮有没有成功发出过正文。 */
+  private readonly turn_visible = new Set<string>()
+  /** 每个 Session 上次推送思考摘要的时间（进度节流）。 */
+  private readonly last_progress_at = new Map<string, number>()
+  private readonly aggregators = new Map<string, ReplyAggregator>()
+  private running: Promise<void> | undefined
+  private stopped = false
+  /** 本机调试注入口（仅当设置 DSH_WEIXIN_INJECT_PORT 时启用）。 */
+  private inject_server: Server | undefined
+  /** 长期记忆（时间线）；DSH_TIMELINE_ENABLED=0 可整体关闭。 */
+  private readonly timeline: TimelineStore | undefined
+  /** 知识图谱（社交网络）：人物 + "谁称呼谁为什么"的有向边。 */
+  private readonly graph: KnowledgeGraphStore
